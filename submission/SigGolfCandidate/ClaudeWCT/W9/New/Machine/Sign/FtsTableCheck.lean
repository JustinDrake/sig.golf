def pkAt (v : Nat) : Nat := if v < 16016 then pk.getD (v % 728) 0 else 0
def packW (w : List Nat) : Nat := (List.range 7).foldl (fun acc i => acc + w.getD i 0 * 4 ^ i) 0
theorem pk_eq : (WCT9.compositions 4 7 6).map packW = pk := by decide +kernel
theorem pk_length : pk.length = 728 := by decide +kernel
set_option maxRecDepth 100000 in
theorem pk_digits_all : ((WCT9.compositions 4 7 6).zip pk).all
    (fun p => (List.range 7).all fun i => p.2 / 4 ^ i % 4 == p.1.getD i 0) = true := by decide +kernel
def rowOK (k : Nat) (row : List (BitVec 8)) : Bool :=
  row.length == 8 && extractWord32 (bytesToWordLE row) 0 == BitVec.ofNat 32 (pkAt (2 * k)) &&
    extractWord32 (bytesToWordLE row) 1 == BitVec.ofNat 32 (pkAt (2 * k + 1))
def rowsOK : Nat → List (List (BitVec 8)) → Bool
  | _, [] => true
  | k, r :: rs => rowOK k r && rowsOK (k + 1) rs
set_option maxRecDepth 100000 in
theorem tbl_rows_ok : rowsOK 0 tblRows = true := by decide +kernel
theorem tblRows_length : tblRows.length = 8192 := by decide +kernel
theorem tblRows_len8 : (tblRows.all fun r => r.length == 8) = true := by decide +kernel
theorem pk_lt_all : ∀ r, r < 728 → pk.getD r 0 < 2 ^ 32 := by decide +kernel
theorem lwu_word : ∀ c, c < 9 → coordLook c (lwuI c) = some 0x000e6c83 := by decide +kernel
theorem lwuI_lt : ∀ c, c < 9 → lwuI c < 16384 := by decide +kernel
