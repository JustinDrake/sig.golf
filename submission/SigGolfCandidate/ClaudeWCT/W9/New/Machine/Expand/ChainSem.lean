open SigGolfCandidate.T3M
set_option linter.unusedSimpArgs false
theorem aX_eval {s : MachineState} {r : Reg} {R : Nat} (h : s.getReg r = BitVec.ofNat 64 R) (o : Nat) :
    (aX r o).eval s = BitVec.ofNat 64 (R + o) := by
  simp only [aX, Addr.eval, E.eval, h, ofNat_add_ofNat]
theorem eX_eval {s : MachineState} {r : Reg} {R : Nat} (h : s.getReg r = BitVec.ofNat 64 R) (o : Nat) :
    (eX r o).eval s = BitVec.ofNat 64 (R + o) := by
  simp only [eX, E.eval, BinOp.eval, h, ofNat_add_ofNat]
theorem ofNat_hbO (H w : Nat) (hH : 2048 ≤ H) : BitVec.ofNat 64 (H + hbO w) = BitVec.ofNat 64 (H - 2048 + w) := by
  apply BitVec.eq_of_toNat_eq
  simp only [BitVec.toNat_ofNat, hbO]
  omega
theorem valid_of {A w : Nat} (hal : A % w = 0) (hhi : A + w ≤ 2 ^ 24) : accessValid (BitVec.ofNat 64 A) w = true := by
  rw [accessValid_iff, toNat_ofNat_lt (by omega)]
  exact ⟨by simp only [MEMORY_BYTES]; omega, hal⟩
structure Bnd (B H : Nat) : Prop where
  b8 : B % 64 = 0
  bhi : B + 1024 ≤ 2 ^ 24
  h8 : H % 8 = 0
  hlo : 2048 ≤ H
  hhi : H + 512 ≤ 2 ^ 24
theorem pcOf_plus (p n : Nat) (x : Word) (hx : x = pcOf p) (k : Nat) (hk : k = n) :
    x + BitVec.ofNat 64 (4 * k) = pcOf (p + n) := by
  subst hx hk; apply BitVec.eq_of_toNat_eq; simp only [pcOf, BitVec.toNat_add, BitVec.toNat_ofNat]; omega
theorem pcOf_add_fours (p : Nat) :
    pcOf p + 4 = pcOf (p + 1) ∧ pcOf p + 4 + 4 = pcOf (p + 2) ∧ pcOf p + 4 + 4 + 4 + 4 = pcOf (p + 4) ∧
      pcOf p + 4 + 4 + 4 + 4 + 4 = pcOf (p + 5) := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
  · apply BitVec.eq_of_toNat_eq
    simp only [pcOf, BitVec.toNat_add, BitVec.toNat_ofNat, show (4 : Word).toNat = 4 from rfl]
    omega
theorem head_spec {im : Image} {p t st a2 B Q : Nat} (ht : t < 7) (hst : st < 3)
    (ha : a2 = offC t + 48 ∨ a2 = slotC t) (hc : CodeAt im (pcOf p) (headW t st a2)) (s : MachineState)
    (hpc : s.pc = pcOf p) (hB : s.getReg .x8 = BitVec.ofNat 64 B) (h31 : s.getReg .x31 = BitVec.ofNat 64 Q)
    (hb8 : B % 64 = 0) (hbhi : B + 1024 ≤ 2 ^ 24) :
    ∃ u, Steps im s 4 4 u ∧ u.pc = pcOf (p + 4) ∧ fetch im u = some (.base .ECALL) ∧
      u.getReg .x10 = BitVec.ofNat 64 (B + offC t) ∧ u.getReg .x12 = BitVec.ofNat 64 (B + a2) ∧
      (∀ r, r ≠ .x10 → r ≠ .x12 → r ≠ .x25 → u.getReg r = s.getReg r) ∧
      u.getMem (BitVec.ofNat 64 (B + offC t + 16)) = BitVec.ofNat 64 (Q + qK t st) ∧
      Frame s u (fun A => A = B + offC t + 16) := by
  have hrun := run_head t st a2 ht hst ha (pcOf p)
  have hoff : offC t + 32 ≤ 1024 ∧ offC t % 64 = 0 := by unfold offC; omega
  have hobl : (headR t st a2 (pcOf p)).obligs s := by
    simp only [Result.obligs, headR, headSt, Oblig.all, Oblig.holds, aX_eval hB]
    exact valid_of (by omega) (by omega)
  have hst' := symRun_sound hrun hc s hpc hobl
  have hec := symRun_ecall hrun hc s hobl rfl
  refine ⟨_, hst', ?_, hec, ?_, ?_, ?_, ?_, ?_⟩
  · simp only [Result.toState_pc, headR, E.eval, (pcOf_add_fours p).2.2.1]
  · simp only [Result.toState_getReg, headR, headSt]
    rw [RegFile.get_set_ne _ _ (by decide), RegFile.get_set_ne _ _ (by decide), RegFile.get_set_self _ _ (by decide),
      eX_eval hB]
  · simp only [Result.toState_getReg, headR, headSt]
    rw [RegFile.get_set_ne _ _ (by decide), RegFile.get_set_self _ _ (by decide), eX_eval hB]
  · intro r h10 h12 h25
    simp only [Result.toState_getReg, headR, headSt]
    rw [RegFile.get_set_ne _ _ h25, RegFile.get_set_ne _ _ h12, RegFile.get_set_ne _ _ h10, RegFile.init_get_eval]
  · simp only [Result.toState_getMem, headR, headSt, memEval_cons, memEval_nil, aX_eval hB, eX_eval h31]
    rw [if_pos (by rw [Nat.add_assoc])]
  · intro A hA hn
    simp only [Result.toState_getMem, headR, headSt, memEval_cons, memEval_nil, aX_eval hB]
    rw [if_neg (by rw [ofNat_eq_iff]; omega)]
theorem rung_spec {im : Image} {p t step B A0 : Nat} (own : Bool) (ht : t < 7) (hs : step = 1 ∨ step = 2)
    (hc : CodeAt im (pcOf p) (rungW step (rungDst t step own))) (s : MachineState) (hpc : s.pc = pcOf p)
    (hB : s.getReg .x8 = BitVec.ofNat 64 B) (hA : s.getReg .x10 = BitVec.ofNat 64 A0) (hA8 : A0 % 8 = 0)
    (hAhi : A0 + 64 ≤ 2 ^ 24) :
    ∃ u, Steps im s ((rungW step (rungDst t step own)).length - 1) ((rungW step (rungDst t step own)).length - 1) u ∧
      u.pc = pcOf (p + ((rungW step (rungDst t step own)).length - 1)) ∧ fetch im u = some (.base .ECALL) ∧
      u.getReg .x12 = (match rungDst t step own with
        | some d => BitVec.ofNat 64 (B + d)
        | none => s.getReg .x12) ∧
      (∀ r, r ≠ .x12 → u.getReg r = s.getReg r) ∧
      u.getMem (BitVec.ofNat 64 (A0 + 16)) = replaceByte (s.getMem (BitVec.ofNat 64 (A0 + 16))) 1
        ((s.getReg (if step = 1 then .x7 else .x13)).truncate 8) ∧
      Frame s u (fun A => A = A0 + 16) := by
  have hrun := run_rung t step own ht hs (pcOf p)
  have hobl : (rungR step (rungDst t step own) (pcOf p)).obligs s := by
    cases h : rungDst t step own <;>
    · simp only [Result.obligs, rungR, rungSt, Oblig.all, Oblig.holds, aX_eval hA, E.eval, hA]
      exact ⟨by rw [toNat_ofNat_lt (by omega)]; exact hA8, valid_of (by omega) (by omega)⟩
  have hst' := symRun_sound hrun hc s hpc hobl
  have hec := symRun_ecall hrun hc s hobl (by cases rungDst t step own <;> rfl)
  have hmem : ∀ A, A < 2 ^ 64 → (Result.toState (rungR step (rungDst t step own) (pcOf p)) s).getMem
      (BitVec.ofNat 64 A) = if A = A0 + 16 then replaceByte (s.getMem (BitVec.ofNat 64 (A0 + 16))) 1
        ((s.getReg (if step = 1 then .x7 else .x13)).truncate 8) else s.getMem (BitVec.ofNat 64 A) := by
    intro A hA'
    cases h : rungDst t step own <;>
    · simp only [Result.toState_getMem, rungR, rungSt, memEval_cons, memEval_nil, aX_eval hA, E.eval,
        eX_eval hA, BinOp.eval, StoreKind.merge]
      by_cases e : A = A0 + 16
      · subst e; simp only [if_true]
      · rw [if_neg (by rw [ofNat_eq_iff]; omega), if_neg e]
  cases h : rungDst t step own with
  | none =>
    refine ⟨_, by simpa [rungR, rungW, h] using hst', ?_, by simpa [rungR, h] using hec, ?_, ?_, ?_, ?_⟩
    · simp only [Result.toState_pc, rungR, rungW, h, E.eval, List.length_append, List.length_cons,
        List.length_nil]
      apply BitVec.eq_of_toNat_eq; simp only [pcOf, BitVec.toNat_add, BitVec.toNat_ofNat]; omega
    · simp only [Result.toState_getReg, rungR, rungSt, h, RegFile.init_get_eval]
    · intro r _; simp only [Result.toState_getReg, rungR, rungSt, h, RegFile.init_get_eval]
    · have := hmem (A0 + 16) (by omega); simp only [rungR, h, if_true] at this ⊢; exact this
    · intro A hA' hn; have := hmem A hA'; simp only [rungR, h, if_neg hn] at this ⊢; exact this
  | some d =>
    refine ⟨_, by simpa [rungR, rungW, h] using hst', ?_, by simpa [rungR, h] using hec, ?_, ?_, ?_, ?_⟩
    · simp only [Result.toState_pc, rungR, rungW, h, E.eval, List.length_append, List.length_cons,
        List.length_nil]
      apply BitVec.eq_of_toNat_eq; simp only [pcOf, BitVec.toNat_add, BitVec.toNat_ofNat]; omega
    · simp only [Result.toState_getReg, rungR, rungSt, h]
      rw [RegFile.get_set_self _ _ (by decide), eX_eval hB]
    · intro r hr; simp only [Result.toState_getReg, rungR, rungSt, h]
      rw [RegFile.get_set_ne _ _ hr, RegFile.init_get_eval]
    · have := hmem (A0 + 16) (by omega); simp only [rungR, h, if_true] at this ⊢; exact this
    · intro A hA' hn; have := hmem A hA'; simp only [rungR, h, if_neg hn] at this ⊢; exact this
theorem copy_spec {im : Image} {p t B : Nat} (h1 : 0 < t) (h5 : t < 6) (hc : CodeAt im (pcOf p) (copyW t))
    (s : MachineState) (hpc : s.pc = pcOf p) (hB : s.getReg .x8 = BitVec.ofNat 64 B) (hb8 : B % 8 = 0)
    (hbhi : B + 1024 ≤ 2 ^ 24) :
    ∃ u, Steps im s 4 4 u ∧ u.pc = pcOf (p + 4) ∧
      (∀ r, r ≠ .x3 → r ≠ .x14 → u.getReg r = s.getReg r) ∧
      u.getMem (BitVec.ofNat 64 (B + slotC t)) = s.getMem (BitVec.ofNat 64 (B + offC t + 48)) ∧
      u.getMem (BitVec.ofNat 64 (B + slotC t + 8)) = s.getMem (BitVec.ofNat 64 (B + offC t + 56)) ∧
      Frame s u (fun A => A = B + slotC t ∨ A = B + slotC t + 8) := by
  have hrun := run_copy t h1 h5 (pcOf p)
  have ho : offC t + 64 ≤ 1024 ∧ offC t % 64 = 0 ∧ slotC t + 16 ≤ 1024 ∧ slotC t % 16 = 0 := by
    unfold offC slotC; split <;> omega
  have hobl : (copyR t (pcOf p)).obligs s := by
    simp only [Result.obligs, copyR, copySt, Oblig.all, Oblig.holds, aX_eval hB]
    exact ⟨valid_of (by omega) (by omega), valid_of (by omega) (by omega), valid_of (by omega) (by omega),
      valid_of (by omega) (by omega)⟩
  refine ⟨_, symRun_sound hrun hc s hpc hobl, ?_, ?_, ?_, ?_, ?_⟩
  · simp only [Result.toState_pc, copyR, E.eval, (pcOf_add_fours p).2.2.1]
  · intro r h3 h14
    simp only [Result.toState_getReg, copyR, copySt]
    rw [RegFile.get_set_ne _ _ h14, RegFile.get_set_ne _ _ h3, RegFile.init_get_eval]
  · simp only [Result.toState_getMem, copyR, copySt, memEval_cons, memEval_nil, aX_eval hB, E.eval, eX_eval hB]
    rw [if_neg (by rw [ofNat_eq_iff]; omega)]; simp only [if_true, Nat.add_assoc]
  · simp only [Result.toState_getMem, copyR, copySt, memEval_cons, memEval_nil, aX_eval hB, E.eval, eX_eval hB]
    rw [if_pos (by rw [Nat.add_assoc]), Nat.add_assoc]
  · intro A hA hn
    simp only [not_or] at hn
    simp only [Result.toState_getMem, copyR, copySt, memEval_cons, memEval_nil, aX_eval hB]
    rw [if_neg (by rw [ofNat_eq_iff]; omega), if_neg (by rw [ofNat_eq_iff]; omega)]
theorem leaf_spec {im : Image} {p B H : Nat} (hc : CodeAt im (pcOf p) leafW) (s : MachineState) (hpc : s.pc = pcOf p)
    (hB : s.getReg .x8 = BitVec.ofNat 64 B) (hH : s.getReg .x28 = BitVec.ofNat 64 H) (hb : Bnd B H) :
    ∃ u, Steps im s 6 6 u ∧ u.pc = s.getReg .x23 &&& 0xfffffffffffffffe#64 ∧
      u.getReg .x10 = BitVec.ofNat 64 (B + 880) ∧ u.getReg .x11 = BitVec.ofNat 64 128 ∧
      (∀ r, r ≠ .x10 → r ≠ .x11 → r ≠ .x25 → u.getReg r = s.getReg r) ∧
      u.getMem (BitVec.ofNat 64 (B + 896)) = s.getMem (BitVec.ofNat 64 (H - 2048 + 456)) ∧
      u.getMem (BitVec.ofNat 64 (B + 904)) = s.getReg .x4 ∧
      Frame s u (fun A => A = B + 896 ∨ A = B + 904) := by
  have hrun := run_leaf (pcOf p)
  have hobl : leafR.obligs s := by
    simp only [Result.obligs, leafR, leafSt, Oblig.all, Oblig.holds, aX_eval hB, aX_eval hH, ofNat_hbO H _ hb.hlo]
    exact ⟨valid_of (by have := hb.b8; omega) (by have := hb.bhi; omega),
      valid_of (by have := hb.b8; omega) (by have := hb.bhi; omega),
      valid_of (by have := hb.h8; have := hb.hlo; omega) (by have := hb.hhi; have := hb.hlo; omega)⟩
  have := hb.bhi
  refine ⟨_, symRun_sound hrun hc s hpc hobl, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp only [Result.toState_pc, leafR, E.eval, BinOp.eval]
  · simp only [Result.toState_getReg, leafR, leafSt]
    rw [RegFile.get_set_ne _ _ (by decide), RegFile.get_set_self _ _ (by decide), eX_eval hB]
  · simp only [Result.toState_getReg, leafR, leafSt]
    rw [RegFile.get_set_self _ _ (by decide)]; rfl
  · intro r h10 h11 h25
    simp only [Result.toState_getReg, leafR, leafSt]
    rw [RegFile.get_set_ne _ _ h11, RegFile.get_set_ne _ _ h10, RegFile.get_set_ne _ _ h25, RegFile.init_get_eval]
  · simp only [Result.toState_getMem, leafR, leafSt, memEval_cons, memEval_nil, aX_eval hB, E.eval, eX_eval hH,
      ofNat_hbO H _ hb.hlo]
    rw [if_neg (by rw [ofNat_eq_iff]; omega)]; simp only [if_true]
  · simp only [Result.toState_getMem, leafR, leafSt, memEval_cons, memEval_nil, aX_eval hB, E.eval]
    simp only [if_true]
  · intro A hA hn
    simp only [not_or] at hn
    simp only [Result.toState_getMem, leafR, leafSt, memEval_cons, memEval_nil, aX_eval hB]
    rw [if_neg (by rw [ofNat_eq_iff]; omega), if_neg (by rw [ofNat_eq_iff]; omega)]
end ClaudeWCT.W9.Machine.Expand
