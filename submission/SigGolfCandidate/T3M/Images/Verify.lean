/-- Bit reversal of the low `n` bits (the same recursion as `T3.Rev.revBits`, `RevNet.tabRev_eq`). -/
def tabRev : Nat → Nat → Nat
  | 0, _ => 0
  | n + 1, v => (v % 2) * 2 ^ n + tabRev n (v / 2)

/-- The FTS header table: doubleword `j < 2048` is `revBits 64 (2048 + j)`, the relabelled word 1 of the tag-9 / tag-10
header of heap node `2048 + j`. -/
def verifyTabWord (j : Nat) : Nat := tabRev 64 (2048 + j)

set_option maxHeartbeats 1200000 in
set_option maxRecDepth 65536 in
