def plan (g j : Nat) : BlockPlan := (plans[g]!)[j]!
def atHash (p : BlockPlan) (side i : Nat) : Nat := (p.hashes[side]!)[i]!
def atRung (p : BlockPlan) (side i : Nat) : Nat := (p.rungs[side]!)[i]!
def cE (n : Word) : E := .c n
def rAdd (r : Reg) (n : Word) : E := addC (.reg r) n
def shifted : E := .bin .sll (.reg .x23) (cE 1)
def slotReg (j : Nat) : Reg := if j=0 then .x16 else if j=1 then .x17 else .x18
def leafSrc (j : Nat) : E := rAdd .x19 (BitVec.ofNat 64 (48*j))
def leafAddr (j off : Nat) : Addr := ⟨some (.reg .x19),BitVec.ofNat 64 (48*j+off)⟩
def frame (d : Nat) : Nat := 0x600+80*d
def dest (p : BlockPlan) : E :=
  if p.variant=2 then .reg .x25
  else cE (BitVec.ofNat 64 (frame p.depth+(if p.variant=0 then 48 else 80)))
def pendingHeap (p : BlockPlan) : E :=
  match p.leaf with
  | some j => .ld (.reg (slotReg j))
  | none => shifted
def pendingSrc (p : BlockPlan) : E :=
  match p.leaf with
  | some j => leafSrc j
  | none => cE (BitVec.ofNat 64 (frame (p.depth+1)))
def pendingMem (p : BlockPlan) : List (Addr × E) :=
  match p.leaf with
  | some j => [(leafAddr j 24,pendingHeap p),(leafAddr j 16,.reg .x28)]
  | none => [(⟨none,BitVec.ofNat 64 (frame (p.depth+1)+24)⟩,pendingHeap p),
    (⟨none,BitVec.ofNat 64 (frame (p.depth+1)+16)⟩,.reg .x27)]
def pendingObl (p : BlockPlan) : List Oblig :=
  match p.leaf with
  | some j => [.valid (leafAddr j 24) 8,.valid (leafAddr j 16) 8,
      .valid ⟨some (.reg (slotReg j)),0⟩ 8]
  | none => []
def pendingSpec (p : BlockPlan) (side : Nat) : Spec :=
  ⟨[(.x10,pendingSrc p),(.x12,if p.folds=0 then dest p else rAdd .x14 (BitVec.ofNat 64 (8+48*side))),
      (.x14,rAdd .x14 (BitVec.ofNat 64 (8+80*p.folds))),(.x23,pendingHeap p)],
    pendingMem p,atHash p side 0,true,(if p.folds=0 then 6 else 7),
    (if p.folds=0 then [] else [⟨.lt,pendingHeap p,cE 0,side==1⟩]),none,
    (if p.folds=0 then 6 else 7)⟩
def pendingKeep : List Reg := [.x1, .x2, .x3, .x4, .x5, .x6, .x7, .x8, .x9, .x11, .x13, .x15, .x16, .x17, .x18, .x19, .x20, .x21, .x22, .x24, .x25, .x26, .x27, .x28, .x29, .x30, .x31]

def pendingCheck (g j side : Nat) : Bool :=
  let p := plan g j
  rawB (runAtC {} [] [] p.start (if p.folds=0 then [] else [.br (side==1)]))
    (pendingSpec p side) (pendingObl p) pendingKeep

def rungAddr (p : BlockPlan) (i off : Nat) : Addr :=
  ⟨some (.reg .x14),BitVec.ofNat 64 (80*i+off)-BitVec.ofNat 64 (80*p.folds)⟩
def rungSrc (p : BlockPlan) (i : Nat) : E :=
  rAdd .x14 (BitVec.ofNat 64 (80*i)-BitVec.ofNat 64 (80*p.folds))
def rungDest (p : BlockPlan) (i side : Nat) : E :=
  if i+1=p.folds then dest p
  else rAdd .x14 (BitVec.ofNat 64 (80*(i+1)+48*side)-BitVec.ofNat 64 (80*p.folds))
def rungMem (p : BlockPlan) (i : Nat) : List (Addr × E) :=
  [(rungAddr p i 24,shifted),(rungAddr p i 16,.reg .x27)]
def rungObl (p : BlockPlan) (i : Nat) : List Oblig :=
  [.valid (rungAddr p i 24) 8,.valid (rungAddr p i 16) 8]
def rungSpec (p : BlockPlan) (i side out : Nat) : Spec :=
  ⟨[(.x10,rungSrc p i),(.x12,rungDest p i out),(.x23,shifted)],
    rungMem p i,atHash p (if i+1=p.folds then side else out) (i+1),true,
    (if i+1=p.folds then 5 else 6),
    (if i+1=p.folds then [] else [⟨if side=0 then .lt else .ge,shifted,cE 0,side != out⟩]),none,
    (if i+1=p.folds then 5 else 6)⟩
def rungKeep : List Reg := [.x1, .x2, .x3, .x4, .x5, .x6, .x7, .x8, .x9, .x11, .x13, .x14, .x15, .x16, .x17, .x18, .x19, .x20, .x21, .x22, .x24, .x25, .x26, .x27, .x28, .x29, .x30, .x31]

def rungCheck (g j i side out : Nat) : Bool :=
  let p := plan g j
  if i ≥ p.folds then true
  else rawB (runAtC {} [] [] (atRung p side i)
    (if i+1=p.folds then [] else [.br (side != out)]))
    (rungSpec p i side out) (rungObl p i) rungKeep

def checkGeom (g : Nat) : Bool :=
  (List.range 5).all fun j => (List.range 2).all fun side =>
    pendingCheck g j side && ((List.range 10).all fun i =>
      (List.range 2).all fun out => rungCheck g j i side out)

end SigGolfCandidate.T3M.CanonicalNative
