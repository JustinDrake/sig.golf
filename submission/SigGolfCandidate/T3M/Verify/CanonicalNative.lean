def fixture : Image := ⟨chunks.flatten, prefixData ++ Images.verifyData⟩

def look (n : Nat) : Option (BitVec 32) :=
  match supers[n/8192]? with
  | some sc => match sc[n/256%32]? with
    | some chunk => chunk[n%256]?
    | none => none
  | none => none

theorem chunks_ok : (chunks.dropLast.all fun c => c.length==256)=true := by decide +kernel
theorem supers_ok : (supers.dropLast.all fun c => c.length==32)=true := by decide +kernel
theorem supers_flatten : supers.flatten=chunks := by kernel_rfl
theorem look_ok : LookOK fixture look := by
  intro n w h
  show chunks.flatten[n]?=some w
  rw [← supers_flatten]
  unfold look at h
  apply lookup_chunks 256 (by decide) supers.flatten n w
    (by rw [supers_flatten]; exact chunks_ok)
  split at h
  · rename_i sc hsc
    split at h
    · rename_i c hc
      have hs : supers.flatten[n/256]?=some c := by
        apply lookup_chunks 32 (by decide) supers (n/256) c supers_ok
        rw [Nat.div_div_eq_div_mul,show 256*32=8192 by rfl,hsc]
        exact hc
      rw [hs]
      exact h
    · cases h
  · cases h

