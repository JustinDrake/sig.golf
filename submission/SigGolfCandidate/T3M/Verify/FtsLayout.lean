def fourStart (X a bits : Nat) : Nat := fourStarts.getD (144*X+16*(a-2)+bits) 0
def fourTailLen (X : Nat) : Nat := if X=0 then 12 else if X=1 then 4 else 1
def fourFoldPc (X a bits t i : Nat) : Nat :=
  let e := fourStart X a bits
  if i<3 then e+6*i else
    e+18+(if t=bits/8%2 then 0 else 8*(a-4)+6+fourTailLen X)+8*(i-3)

/-- The copied tail index following the last fold. -/
def fourTailId (a bits t : Nat) : Nat :=
  if a=2 then 3+(bits%4)/2 else if a=3 then 5+(bits%8)/2 else
    9+16*(a-4)+2*(bits/2)+(if t=bits/8%2 then 0 else 1)

