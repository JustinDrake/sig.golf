def threeStart (X a bits : Nat) : Nat := threeStarts.getD (80*X+8*(a-2)+bits) 0

def threeTailLen (X : Nat) : Nat := if X=0 then 12 else if X=1 then 4 else 1

def threeFoldPc (X a bits t i : Nat) : Nat :=
  let e := threeStart X a bits
  if i<2 then e+6*i else
    e+12+(if t=bits/4%2 then 0 else 8*(a-3)+6+threeTailLen X)+8*(i-2)

/-- The copied tail index following the last fold. -/
def threeTailId (a bits t : Nat) : Nat :=
  if a=2 then 3+bits else 11+16*(a-3)+2*bits+(if t=bits/4%2 then 0 else 1)

